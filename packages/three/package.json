{
  "name": "@pibbl/three",
  "type": "module",
  "version": "0.0.1",
  "description": "Three.js render layers for the Pibbl Canvas component runtime",
  "author": "Ben Lesh <ben@benlesh.com>",
  "license": "MIT",
  "homepage": "https://github.com/benlesh/pibbl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benlesh/pibbl.git",
    "directory": "packages/three"
  },
  "bugs": "https://github.com/benlesh/pibbl/issues",
  "keywords": [
    "canvas",
    "three",
    "three.js",
    "webgl",
    "graphics"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ../../tooling/preserve-declaration-jsdoc.mjs src dist && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=esnext --sourcemap --outfile=dist/index.mjs --external:@pibbl/core --external:three",
    "dev": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "vitest"
  },
  "peerDependencies": {
    "@pibbl/core": "0.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@pibbl/core": "workspace:*",
    "@types/three": "catalog:",
    "three": "catalog:"
  }
}
