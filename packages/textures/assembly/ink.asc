// @ts-nocheck -- AssemblyScript source, compiled by asc, not TypeScript.
// Explicit f64 intermediates preserve JS arithmetic; stores round to f32.
@inline
function value(base: usize, i: i32): f64 { return f64(load<f32>(base + usize(i) * 4)); }
@inline
function lap(base: usize, i: i32, row: i32, up: i32, down: i32, x: i32, left: i32, right: i32): f64 {
  return -value(base, i)
    + 0.2 * (value(base, row + left) + value(base, row + right) + value(base, up + x) + value(base, down + x))
    + 0.05 * (value(base, up + left) + value(base, up + right) + value(base, down + left) + value(base, down + right));
}
export function advance(a: usize, b: usize, na: usize, nb: usize, w: i32, h: i32, count: i32, feed: f64, kill: f64): void {
  for (let step = 0; step < count; step++) {
    for (let y = 0; y < h; y++) {
      const row = y * w, up = (y == 0 ? h - 1 : y - 1) * w, down = (y + 1 == h ? 0 : y + 1) * w;
      for (let x = 0; x < w; x++) {
        const left = x == 0 ? w - 1 : x - 1, right = x + 1 == w ? 0 : x + 1, i = row + x;
        const av = value(a, i), bv = value(b, i), reaction = av * bv * bv;
        store<f32>(na + usize(i) * 4, f32(Math.max(0, Math.min(1, av + lap(a, i, row, up, down, x, left, right) - reaction + feed * (1 - av)))));
        store<f32>(nb + usize(i) * 4, f32(Math.max(0, Math.min(1, bv + 0.5 * lap(b, i, row, up, down, x, left, right) + reaction - (kill + feed) * bv))));
      }
    }
    let temp = a; a = na; na = temp; temp = b; b = nb; nb = temp;
  }
}
export function colorize(field: usize, lut: usize, pixels: usize, alpha: usize, count: i32, gain: f64): void {
  for (let i = 0; i < count; i++) {
    const v = i32(Math.max(0, Math.min(255, Math.floor(value(field, i) * 255 * gain + 0.5))));
    store<u32>(pixels + usize(i) * 4, load<u32>(lut + usize(v) * 4) | 0xff000000);
    store<u8>(alpha + usize(i), u8(v));
  }
}

function seedPatch(a: usize, b: usize, w: i32, h: i32, x: f64, y: f64, radius: f64, strength: f64): void {
  const minY = i32(Math.max(0,Math.floor(y-radius))), maxY = i32(Math.min(h-1,Math.ceil(y+radius)));
  const minX = i32(Math.max(0,Math.floor(x-radius))), maxX = i32(Math.min(w-1,Math.ceil(x+radius)));
  for(let py=minY;py<=maxY;py++) {
    for(let px=minX;px<=maxX;px++) {
      const distance=Math.hypot(px+0.5-x,py+0.5-y)/radius;
      if(distance>=1)continue;
      const amount=strength*Math.min(1,(1-distance)*3), i=py*w+px;
      const av=value(a,i),bv=value(b,i);
      store<f32>(a+usize(i)*4,f32(av+(0.2-av)*amount));
      store<f32>(b+usize(i)*4,f32(bv+(0.9-bv)*amount));
    }
  }
}
export function paintBatch(a: usize,b: usize,w: i32,h: i32,stamps: usize,count: i32): void {
  for(let i=0;i<count;i++) {
    const base=stamps+usize(i)*32;
    const x=load<f64>(base),y=load<f64>(base+8),radius=load<f64>(base+16),strength=load<f64>(base+24);
    const seedRadius=Math.min(radius,3),spread=radius-seedRadius,extent=Math.floor(spread/6)*6;
    let hasCandidate=false;
    for(let dy=-extent;dy<=extent;dy+=12) {
      for(let dx=-extent;dx<=extent;dx+=12) {
        if(Math.hypot(dx,dy)>spread)continue;
        hasCandidate=true;
        seedPatch(a,b,w,h,x+dx,y+dy,seedRadius,strength*0.45);
      }
    }
    if(!hasCandidate)seedPatch(a,b,w,h,x,y,seedRadius,strength*0.45);
  }
}

let randomState: i32 = 0;
function random(): f64 {
  randomState += 0x6d2b79f5;
  let n = (randomState ^ (randomState >>> 15)) * (1 | randomState);
  n ^= n + (n ^ (n >>> 7)) * (61 | n);
  return f64(u32(n ^ (n >>> 14))) / 4294967296;
}
export function initialize(a: usize, b: usize, w: i32, h: i32, seed: i32): void {
  for (let i = 0; i < w*h; i++) store<f32>(a + usize(i)*4, 1);
  randomState = seed;
  for (let i = 0; i < i32(Math.max(6, Math.floor(f64(w*h)/500))); i++) {
    seedPatch(a, b, w, h, random()*w, random()*h, 1.5+random()*2, .9);
  }
}
