// @ts-nocheck -- AssemblyScript source, compiled by asc, not TypeScript.
// A bounded, damped height field with reflecting outer and solid boundaries.
@inline
function readValue(field: usize, i: i32): f64 {
  return f64(load<f32>(field + usize(i) * 4));
}

export function clear(height: usize, velocity: usize, nextHeight: usize, nextVelocity: usize, count: i32): void {
  for (let i = 0; i < count; i++) {
    const offset = usize(i) * 4;
    store<f32>(height + offset, 0);
    store<f32>(velocity + offset, 0);
    store<f32>(nextHeight + offset, 0);
    store<f32>(nextVelocity + offset, 0);
  }
}

export function impulse(velocity: usize, solid: usize, width: i32, height: i32, u: f64, v: f64, radius: f64, strength: f64): void {
  const cx = u * f64(width - 1), cy = v * f64(height - 1);
  const extent = i32(Math.ceil(radius));
  const minX: i32 = i32(Math.max(0, i32(Math.floor(cx)) - extent)), maxX: i32 = i32(Math.min(width - 1, i32(Math.floor(cx)) + extent));
  const minY: i32 = i32(Math.max(0, i32(Math.floor(cy)) - extent)), maxY: i32 = i32(Math.min(height - 1, i32(Math.floor(cy)) + extent));
  for (let y = minY; y <= maxY; y++) for (let x = minX; x <= maxX; x++) {
    const i: i32 = y * width + x;
    if (load<u8>(solid + usize(i)) != 0) continue;
    const distance = Math.hypot(f64(x) - cx, f64(y) - cy) / radius;
    if (distance >= 1) continue;
    const pulse = (1 - distance) * (1 - distance) * strength;
    const offset = usize(i) * 4;
    store<f32>(velocity + offset, f32(readValue(velocity, i) + pulse));
  }
}

// Returns summed absolute height and velocity, used for bounded idle admission.
export function step(height: usize, velocity: usize, nextHeight: usize, nextVelocity: usize, solid: usize, width: i32, rows: i32, dt: f64, waveSpeed: f64, damping: f64): f64 {
  const count = width * rows;
  for (let y = 0; y < rows; y++) for (let x = 0; x < width; x++) {
    const i = y * width + x, offset = usize(i) * 4;
    if (load<u8>(solid + usize(i)) != 0) {
      store<f32>(nextHeight + offset, 0); store<f32>(nextVelocity + offset, 0); continue;
    }
    const h = readValue(height, i);
    const left = x > 0 && load<u8>(solid + usize(i - 1)) == 0 ? readValue(height, i - 1) : h;
    const right = x + 1 < width && load<u8>(solid + usize(i + 1)) == 0 ? readValue(height, i + 1) : h;
    const up = y > 0 && load<u8>(solid + usize(i - width)) == 0 ? readValue(height, i - width) : h;
    const down = y + 1 < rows && load<u8>(solid + usize(i + width)) == 0 ? readValue(height, i + width) : h;
    const nextV = (readValue(velocity, i) + (left + right + up + down - 4 * h) * waveSpeed * waveSpeed * dt) * damping;
    store<f32>(nextVelocity + offset, f32(nextV));
    store<f32>(nextHeight + offset, f32(h + nextV * dt));
  }
  let energy: f64 = 0;
  for (let i = 0; i < count; i++) {
    const offset = usize(i) * 4, h = readValue(nextHeight, i), v = readValue(nextVelocity, i);
    store<f32>(height + offset, f32(h)); store<f32>(velocity + offset, f32(v));
    energy += Math.abs(h) + Math.abs(v) * 0.12;
  }
  return energy;
}

export function clearMask(solid: usize, count: i32): void { memory.fill(solid, 0, usize(count)); }
export function maskRectangle(solid: usize, width: i32, rows: i32, left: f64, top: f64, w: f64, h: f64): void {
  for (let y = 0; y < rows; y++) for (let x = 0; x < width; x++) {
    const u = (f64(x) + 0.5) / width, v = (f64(y) + 0.5) / rows;
    if (u >= left && u < left + w && v >= top && v < top + h) store<u8>(solid + usize(y * width + x), 1);
  }
}
export function maskFields(height: usize, velocity: usize, nextHeight: usize, nextVelocity: usize, solid: usize, count: i32): void {
  for (let i = 0; i < count; i++) if (load<u8>(solid + usize(i)) != 0) {
    const p = usize(i) * 4;
    store<f32>(height+p, 0); store<f32>(velocity+p, 0); store<f32>(nextHeight+p, 0); store<f32>(nextVelocity+p, 0);
  }
}
export function wake(velocity: usize, solid: usize, width: i32, rows: i32, bx: f64, by: f64, bw: f64, bh: f64, ax: f64, ay: f64, aw: f64, ah: f64): f64 {
  const dx = ax + aw / 2 - (bx + bw / 2), dy = ay + ah / 2 - (by + bh / 2);
  const distance = Math.hypot(dx * width, dy * rows);
  if (distance <= 1e-6) return 0;
  const u = Math.max(0, Math.min(1, dx > 0 ? bx - 1 / f64(width) : dx < 0 ? bx + bw + 1 / f64(width) : bx + bw / 2));
  const v = Math.max(0, Math.min(1, dy > 0 ? by - 1 / f64(rows) : dy < 0 ? by + bh + 1 / f64(rows) : by + bh / 2));
  const strength = Math.min(2, distance * 0.12);
  impulse(velocity, solid, width, rows, u, v, Math.max(2, Math.min(width, rows) * 0.075), strength * 1.8);
  return strength;
}
export function steps(height: usize, velocity: usize, nextHeight: usize, nextVelocity: usize, solid: usize, width: i32, rows: i32, count: i32, viscosity: f64): f64 {
  let energy: f64 = 0;
  const speed = 30 / (1 + 4 * viscosity), damping = Math.pow(0.996, 1 + 30 * viscosity);
  for (let i = 0; i < count; i++) energy = step(height, velocity, nextHeight, nextVelocity, solid, width, rows, 1 / 120.0, speed, damping);
  return energy;
}
@inline function sample(height: usize, width: i32, rows: i32, u: f64, v: f64): f64 {
  const x = i32(Math.max(0, Math.min(width - 1, Math.floor(u * (width - 1) + 0.5))));
  const y = i32(Math.max(0, Math.min(rows - 1, Math.floor(v * (rows - 1) + 0.5))));
  return readValue(height, y * width + x);
}
export function raster(height: usize, solid: usize, width: i32, rows: i32, pixels: usize, outWidth: i32, outHeight: i32, modes: usize, time: f64, strength: f64): void {
  for (let y = 0; y < outHeight; y++) for (let x = 0; x < outWidth; x++) {
    const u = outWidth <= 1 ? 0 : f64(x) / (outWidth - 1), v = outHeight <= 1 ? 0 : f64(y) / (outHeight - 1);
    const ix = i32(Math.min(width-1, Math.floor(u * (width-1) + 0.5))), iy = i32(Math.min(rows-1, Math.floor(v * (rows-1) + 0.5)));
    const out = pixels + usize(y * outWidth + x) * 4;
    if (load<u8>(solid + usize(iy * width + ix)) != 0) { store<u32>(out, 0); continue; }
    let dx = (sample(height,width,rows,u + 1/f64(width),v) - sample(height,width,rows,u - 1/f64(width),v)) * width * 0.45 * strength;
    let dy = (sample(height,width,rows,u,v + 1/f64(rows)) - sample(height,width,rows,u,v - 1/f64(rows))) * rows * 0.45 * strength;
    for (let i = 0; i < 4; i++) {
      const p = modes + usize(i) * 24, mx = load<f64>(p), my = load<f64>(p+8);
      const phase = Math.PI * 2 * (mx*u + my*v) + time + load<f64>(p+16);
      dx += Math.cos(phase) * sign(my) * 0.11; dy += Math.sin(phase) * -sign(mx) * 0.11;
    }
    store<u8>(out,encode(dx,92)); store<u8>(out+1,encode(dy,92)); store<u8>(out+2,128); store<u8>(out+3,255);
  }
}
