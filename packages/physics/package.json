{
  "name": "@crc/physics",
  "type": "module",
  "version": "0.0.1",
  "description": "First-class 2D physics for the CRC Canvas component runtime",
  "author": "Ben Lesh <ben@benlesh.com>",
  "license": "MIT",
  "homepage": "https://github.com/benlesh/crc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benlesh/crc.git",
    "directory": "packages/physics"
  },
  "bugs": "https://github.com/benlesh/crc/issues",
  "keywords": [
    "canvas",
    "physics",
    "2d",
    "graphics"
  ],
  "sideEffects": false,
  "exports": {
    "./2d": {
      "types": "./dist/2d.d.ts",
      "default": "./dist/2d.mjs"
    },
    "./2d/geometry": {
      "types": "./dist/2d-geometry.d.ts",
      "default": "./dist/2d-geometry.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && esbuild src/2d.ts src/2d-geometry.ts --bundle --splitting --format=esm --platform=neutral --target=esnext --sourcemap --outdir=dist --out-extension:.js=.mjs --chunk-names=chunks/[name]-[hash] --external:@crc/core --external:@crc/core/internal",
    "dev": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:geometry",
    "test:geometry": "vitest run src/lib/2d/public-types.test.ts --browser.enabled=false --environment node"
  },
  "peerDependencies": {
    "@crc/core": "0.0.1"
  },
  "peerDependenciesMeta": {
    "@crc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@crc/core": "workspace:*"
  }
}
