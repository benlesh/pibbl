{
  "name": "@pibbl/text",
  "version": "0.0.1",
  "type": "module",
  "description": "Editable text outlines for Pibbl, powered by HarfBuzz WASM",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/testing.mjs"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "node scripts/test.mjs",
    "bench": "node scripts/bench.mjs",
    "test:browser": "node test/studio.browser.mjs",
    "bench:browser": "node scripts/bench-browser.mjs",
    "verify:reproducible": "node scripts/reproducible.mjs",
    "reference": "node scripts/reference.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@pibbl/core": "0.0.1"
  },
  "devDependencies": {
    "@pibbl/core": "workspace:*"
  },
  "browser": {
    "./dist/engine.mjs": "./dist/engine-browser.mjs"
  },
  "author": "Ben Lesh <ben@benlesh.com>",
  "homepage": "https://github.com/benlesh/crc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benlesh/crc.git",
    "directory": "packages/text"
  },
  "bugs": "https://github.com/benlesh/crc/issues"
}
