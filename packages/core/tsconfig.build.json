{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "paths": {
      "@pibbl/core": ["./src/index.ts"],
      "@pibbl/core/internal": ["./src/internal.ts"]
    },
    "rootDir": "./src",
    "types": []
  },
  "files": [
    "src/index.ts",
    "src/internal.ts",
    "src/filters.ts",
    "src/types.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts",
    "src/features/particles/index.ts",
    "src/features/viz/index.ts",
    "src/features/textures/index.ts",
    "src/features/machines/index.ts",
    "src/features/machines/animation.ts",
    "src/features/sprites/index.ts",
    "src/features/sprites/formats/aseprite.ts",
    "src/features/sprites/formats/texture-packer.ts",
    "src/features/physics/2d.ts",
    "src/features/physics/2d-geometry.ts",
    "src/features/physics/2d-testing.ts"
  ],
  "include": []
}
