let seed: f64 = 0;
export function initialize(value: f64): void { seed = value; }
function noise(n: f64): f64 { const v = Math.sin(n * 127.1 + seed * 31.7) * 43758.5453; return v - Math.floor(v); }
function put(i: i32, value: f64): void { store<f64>(16384 + i * 8, value); }
export function sample(q: f64, brightness: f64, fog: f64, glitch: f64, rx: f64, ry: f64, rw: f64, rh: f64, ex: f64, ey: f64): void {
  const y = ry + rh * (1 - q), power = Math.pow(Math.sin(Math.PI * q), .65) * brightness;
  put(0, y); put(1, power);
  for(let i=0;i<9;i++) {
    const pulse = Math.pow(Math.max(0, Math.sin(q * (35 + noise(i) * 24) + i * 2.7)), 12) * (1 - q) * glitch;
    const o=2+i*4; put(o,pulse); put(o+1,ry+noise(i+11)*rh); put(o+2,2+noise(i+21)*7); put(o+3,(noise(i+31)-.5)*28*pulse);
  }
  for(let i=0;i<25;i++) put(38+i,power*(.035+noise(i)*.045));
  for(let i=0;i<24;i++) {
    const drift = (noise(i+17)+q*.3)%1, o=63+i*5;
    put(o,ex+(rx+rw/2-ex)*drift+Math.sin(i*2.4+q*3)*rw*.24);
    put(o+1,ey+(y-ey)*drift); put(o+2,16+noise(i)*rw*.16); put(o+3,8+noise(i+3)*19); put(o+4,power*fog*.065);
  }
}
