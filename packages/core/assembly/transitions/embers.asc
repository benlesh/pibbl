// All offsets are Float64 indices relative to the fixed output base (16384).
// contour:0..1025, coals:1026..1565, particles:1566..11165,
// history input:11166..12365, birth times:12366..13565.
let seed: f64 = 0;
export function initialize(value: f64): void { seed = value; }
function noise(n: f64): f64 { const v = Math.sin(n * 127.1 + seed * 31.7) * 43758.5453; return v - Math.floor(v); }
function put(i: i32, value: f64): void { store<f64>(16384 + i * 8, value); }
function get(i: i32): f64 { return load<f64>(16384 + i * 8); }
function burnAt(x: f64, q: f64, ry: f64, rh: f64): f64 {
  const roughness = Math.min(5, rh * .015);
  return ry+rh+roughness*2-q*(rh+roughness*4)+roughness*(Math.sin(x*.12+seed+q*6)*.65+Math.sin(x*.37-q*10)*.4+Math.sin(x*.71+q*14+Math.sin(x*.18-q*8))*.2);
}
// History stays in the JS controller; gather its values once between these calls.
export function births(elapsed: f64, linger: f64): void {
  for(let i=0;i<1200;i++) {
    const lifetime=linger*(.55+.45*noise(i+5)), period=lifetime*1.4, offset=noise(i+19)*period;
    put(12366+i,linger != 0 ? Math.floor((elapsed-offset)/period)*period+offset : 0);
  }
}
export function sample(q: f64, entering: f64, elapsed: f64, linger: f64, wind: f64, burnWidth: f64, rx: f64, ry: f64, rw: f64, rh: f64, segments: i32): void {
  for(let i=0;i<=segments;i++) {const x=rx+f64(i)/f64(segments)*rw;put(i*2,x);put(i*2+1,burnAt(x,q,ry,rh));}
  for(let i=0;i<180;i++) {const x=rx+noise(i*3)*rw,o=1026+i*3;put(o,x);put(o+1,burnAt(x,q,ry,rh)+noise(i*3+1)*burnWidth);put(o+2,1+noise(i*3+2)*burnWidth*.6);}
  const flow=(entering != 0 ? q : 1-q)*3, power=Math.min(1,Math.min(q*12,(1-q)*12));
  for(let i=0;i<1200;i++) {
    const o=1566+i*8,x=rx+noise(i*7)*rw,lifetime=linger*(.55+.45*noise(i+5));
    const born=get(12366+i),age=linger != 0 ? (elapsed-born)/lifetime : (noise(i+19)+flow*(.4+noise(i+5)*.6))%1;
    const birthProgress=linger != 0 ? get(11166+i) : q;
    put(o+5,-1);
    if(linger != 0 && (born<0 || age>=1 || birthProgress<=0 || birthProgress>=1)) continue;
    put(o,x);put(o+1,burnAt(x,birthProgress,ry,rh)+2);put(o+2,1+noise(i+9)*3);
    // An integrated drag impulse starts at the birth point and quickly loses
    // velocity. The remaining motion is the slower wind/buoyant float.
    const burst = 1 - Math.exp(-age * 12);
    const angle = noise(i + 41) * Math.PI * 2;
    const impulse = 12 + noise(i + 53) * 18;
    put(o+3,age*wind+Math.cos(angle)*impulse*burst+Math.sin(age*9+i)*age*age*12);
    put(o+4,Math.sin(angle)*impulse*burst-age*(18+noise(i+11)*35));
    put(o+5,(linger != 0 ? 1 : power)*Math.pow(1-age,1.35));put(o+6,i+age*5);put(o+7,age);
  }
}

// Optional controller-owned simulation state at index 14000: x/y/vx/vy/birth/oldX/oldY.
export function resetPhysics(): void { for(let i=0;i<1200;i++)put(14000+i*7+4,-1); }
export function stepPhysics(elapsed: f64, delta: f64, gx: f64, gy: f64, wx: f64, wy: f64, drag: f64, linger: f64): void {
  for(let i=0;i<1200;i++) {
    const o=1566+i*8,s=14000+i*7,born=get(12366+i);
    if(get(o+5)<0){put(s+4,-1);continue;}
    let dt=delta;
    if(get(s+4)!=born){
      put(s,get(o));put(s+1,get(o+1));put(s+4,born);
      const lifetime=linger*(.55+.45*noise(i+5))/1000;
      const angle=noise(i+41)*Math.PI*2,speed=(12+noise(i+53)*18)*12/lifetime;
      put(s+2,Math.cos(angle)*speed);put(s+3,Math.sin(angle)*speed);
      dt=Math.min(dt,Math.max(0,(elapsed-born)/1000));
    }
    put(s+5,get(s));put(s+6,get(s+1));
    const decay=Math.exp(-drag*dt);
    const vx=wx+(get(s+2)-wx)*decay+gx*dt,vy=wy+(get(s+3)-wy)*decay+gy*dt;
    put(s+2,vx);put(s+3,vy);put(s,get(s)+vx*dt);put(s+1,get(s+1)+vy*dt);
  }
}
export function collidePhysics(i: i32, fraction: f64, nx: f64, ny: f64, restitution: f64): void {
  const s=14000+i*7;
  put(s,get(s+5)+(get(s)-get(s+5))*fraction+nx*.05);
  put(s+1,get(s+6)+(get(s+1)-get(s+6))*fraction+ny*.05);
  const vn=get(s+2)*nx+get(s+3)*ny;
  if(vn<0){put(s+2,get(s+2)-(1+restitution)*vn*nx);put(s+3,get(s+3)-(1+restitution)*vn*ny);}
}
export function presentPhysics(): void {
  for(let i=0;i<1200;i++) {
    const o=1566+i*8,s=14000+i*7;
    if(get(s+4)!=get(12366+i)){put(o+5,-1);continue;}
    put(o+3,get(s)-get(o));put(o+4,get(s+1)-get(o+1));
  }
}

// Committed obstacle batch at 22400. All particle sweeps and bounce arithmetic
// stay in this module. Boxes/ellipses use the physicsObstacles2D ten-number ABI;
// polygons store count, velocity/COM metadata, then world-local vertex pairs.
export function collideObstacles(boxes: i32, ellipses: i32, polygons: i32, restitution: f64): void {
  const roundEnd=22400+boxes+ellipses, end=roundEnd+polygons;
  for(let i=0;i<1200;i++) {
    const s=14000+i*7;
    if(get(s+4)<0)continue;
    const ox=get(s+5),oy=get(s+6),dx=get(s)-ox,dy=get(s+1)-oy;
    if(dx*dx+dy*dy<1e-20)continue;
    let best:f64=2,nx:f64=0,ny:f64=0;
    for(let at=22400;at<roundEnd;at+=10) {
      const c=Math.cos(get(at+4)),sn=Math.sin(get(at+4));
      const rx=ox-get(at),ry=oy-get(at+1);
      const x=c*rx+sn*ry,y=-sn*rx+c*ry,vx=c*dx+sn*dy,vy=-sn*dx+c*dy;
      const hx=get(at+2),hy=get(at+3);
      let t:f64=2,lx:f64=0,ly:f64=0;
      if(at<22400+boxes) {
        if(Math.abs(x)<=hx && Math.abs(y)<=hy)continue;
        let near:f64=-Infinity,far:f64=Infinity;
        if(Math.abs(vx)<1e-12){if(Math.abs(x)>hx)continue;}
        else {
          const a=(-hx-x)/vx,b=(hx-x)/vx;
          near=Math.min(a,b);far=Math.max(a,b);lx=vx>0?-1:1;
        }
        if(Math.abs(vy)<1e-12){if(Math.abs(y)>hy)continue;}
        else {
          const a=(-hy-y)/vy,b=(hy-y)/vy,n=Math.min(a,b);
          if(n>near){near=n;lx=0;ly=vy>0?-1:1;}
          far=Math.min(far,Math.max(a,b));
        }
        if(near>far || near<0 || near>1)continue;
        t=near;
      } else {
        const ex=x/hx,ey=y/hy,evx=vx/hx,evy=vy/hy;
        const a=evx*evx+evy*evy,b=ex*evx+ey*evy,k=ex*ex+ey*ey-1;
        if(k<=0 || a<1e-24)continue;
        const d=b*b-a*k;if(d<0)continue;
        t=(-b-Math.sqrt(d))/a;if(t<0 || t>1)continue;
        lx=(x+t*vx)/(hx*hx);ly=(y+t*vy)/(hy*hy);
        const length=Math.sqrt(lx*lx+ly*ly);lx/=length;ly/=length;
      }
      if(t<best){best=t;nx=c*lx-sn*ly;ny=sn*lx+c*ly;}
    }
    for(let at=roundEnd;at<end;) {
      const count=i32(get(at)),start=at+6;
      // Even/odd containment matches the point sweep's initial-overlap policy.
      let inside=false;
      for(let j=0,k=count-1;j<count;k=j++) {
        const ax=get(start+j*2),ay=get(start+j*2+1),bx=get(start+k*2),by=get(start+k*2+1);
        if((ay>oy)!=(by>oy) && ox<(bx-ax)*(oy-ay)/(by-ay)+ax)inside=!inside;
      }
      if(!inside)for(let j=0;j<count;j++) {
        const k=(j+1)%count,ax=get(start+j*2),ay=get(start+j*2+1);
        const ex=get(start+k*2)-ax,ey=get(start+k*2+1)-ay,det=dx*ey-dy*ex;
        if(Math.abs(det)<1e-12)continue;
        const rx=ax-ox,ry=ay-oy,t=(rx*ey-ry*ex)/det,u=(rx*dy-ry*dx)/det;
        if(t<0 || t>1 || u<0 || u>1 || t>=best)continue;
        const length=Math.sqrt(ex*ex+ey*ey);if(length<1e-12)continue;
        best=t;nx=ey/length;ny=-ex/length;
        if(nx*dx+ny*dy>0){nx=-nx;ny=-ny;}
      }
      at=start+count*2;
    }
    if(best<=1)collidePhysics(i,best,nx,ny,restitution);
  }
}
