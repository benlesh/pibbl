// All offsets are Float64 indices relative to the fixed output base (16384).
// contour:0..1025, coals:1026..1565, particles:1566..11165,
// history input:11166..12365, birth times:12366..13565.
let seed: f64 = 0;
export function initialize(value: f64): void { seed = value; }
function noise(n: f64): f64 { const v = Math.sin(n * 127.1 + seed * 31.7) * 43758.5453; return v - Math.floor(v); }
function put(i: i32, value: f64): void { store<f64>(16384 + i * 8, value); }
function get(i: i32): f64 { return load<f64>(16384 + i * 8); }
function burnAt(x: f64, q: f64, ry: f64, rh: f64): f64 {
  const roughness = Math.min(5, rh * .015);
  return ry+rh+roughness*2-q*(rh+roughness*4)+roughness*(Math.sin(x*.12+seed+q*6)*.65+Math.sin(x*.37-q*10)*.4+Math.sin(x*.71+q*14+Math.sin(x*.18-q*8))*.2);
}
// History stays in the JS controller; gather its values once between these calls.
export function births(elapsed: f64, linger: f64): void {
  for(let i=0;i<1200;i++) {
    const lifetime=linger*(.55+.45*noise(i+5)), period=lifetime*1.4, offset=noise(i+19)*period;
    put(12366+i,linger != 0 ? Math.floor((elapsed-offset)/period)*period+offset : 0);
  }
}
export function sample(q: f64, entering: f64, elapsed: f64, linger: f64, wind: f64, burnWidth: f64, rx: f64, ry: f64, rw: f64, rh: f64, segments: i32): void {
  for(let i=0;i<=segments;i++) {const x=rx+f64(i)/f64(segments)*rw;put(i*2,x);put(i*2+1,burnAt(x,q,ry,rh));}
  for(let i=0;i<180;i++) {const x=rx+noise(i*3)*rw,o=1026+i*3;put(o,x);put(o+1,burnAt(x,q,ry,rh)+noise(i*3+1)*burnWidth);put(o+2,1+noise(i*3+2)*burnWidth*.6);}
  const flow=(entering != 0 ? q : 1-q)*3, power=Math.min(1,Math.min(q*12,(1-q)*12));
  for(let i=0;i<1200;i++) {
    const o=1566+i*8,x=rx+noise(i*7)*rw,lifetime=linger*(.55+.45*noise(i+5));
    const born=get(12366+i),age=linger != 0 ? (elapsed-born)/lifetime : (noise(i+19)+flow*(.4+noise(i+5)*.6))%1;
    const birthProgress=linger != 0 ? get(11166+i) : q;
    put(o+5,-1);
    if(linger != 0 && (born<0 || age>=1 || birthProgress<=0 || birthProgress>=1)) continue;
    put(o,x);put(o+1,burnAt(x,birthProgress,ry,rh)+2);put(o+2,1+noise(i+9)*3);
    // An integrated drag impulse starts at the birth point and quickly loses
    // velocity. The remaining motion is the slower wind/buoyant float.
    const burst = 1 - Math.exp(-age * 12);
    const angle = noise(i + 41) * Math.PI * 2;
    const impulse = 12 + noise(i + 53) * 18;
    put(o+3,age*wind+Math.cos(angle)*impulse*burst+Math.sin(age*9+i)*age*age*12);
    put(o+4,Math.sin(angle)*impulse*burst-age*(18+noise(i+11)*35));
    put(o+5,(linger != 0 ? 1 : power)*Math.pow(1-age,1.35));put(o+6,i+age*5);put(o+7,age);
  }
}
