// @ts-nocheck -- fixed memory: modes at 65536, ripple count at 65632,
// sixteen x/y/age records at 65640, RGBA at 66024.
const MODES: usize = 65536;
const COUNT: usize = 65632;
const RIPPLES: usize = 65640;
export function reset(): void { store<i32>(COUNT, 0); }
export function ripple(x: f64, y: f64): void {
  let count = load<i32>(COUNT);
  if (count == 16) { memory.copy(RIPPLES, RIPPLES + 24, 15 * 24); count = 15; }
  const p = RIPPLES + usize(count) * 24;
  store<f64>(p, x); store<f64>(p + 8, y); store<f64>(p + 16, 0);
  store<i32>(COUNT, count + 1);
}
export function advance(elapsed: f64): i32 {
  let retained = 0;
  for (let i = 0, count = load<i32>(COUNT); i < count; i++) {
    const p = RIPPLES + usize(i) * 24, age = load<f64>(p + 16) + elapsed;
    if (age >= 2.4) continue;
    const out = RIPPLES + usize(retained++) * 24;
    store<f64>(out, load<f64>(p)); store<f64>(out + 8, load<f64>(p + 8)); store<f64>(out + 16, age);
  }
  store<i32>(COUNT, retained); return retained;
}
export function raster(pixels: usize, width: i32, height: i32, time: f64, strength: f64): void {
  for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
    const u = width <= 1 ? 0 : f64(x) / f64(width - 1), v = height <= 1 ? 0 : f64(y) / f64(height - 1);
    let dx: f64 = 0, dy: f64 = 0;
    for (let i = 0; i < 4; i++) {
      const p = MODES + usize(i) * 24, mx = load<f64>(p), my = load<f64>(p + 8);
      const phase = Math.PI * 2 * (mx * u + my * v) + time + load<f64>(p + 16);
      dx += Math.cos(phase) * sign(my) * 0.25; dy += Math.sin(phase) * -sign(mx) * 0.25;
    }
    for (let i = 0, count = load<i32>(COUNT); i < count; i++) {
      const p = RIPPLES + usize(i) * 24;
      const horizontal = (u - load<f64>(p)) * width / Math.min(width, height);
      const vertical = (v - load<f64>(p + 8)) * height / Math.min(width, height);
      const distance = Math.hypot(horizontal, vertical), progress = load<f64>(p + 16) / 2.4;
      const difference = distance - progress * 1.75;
      const ring = Math.exp(-(difference * difference) / 0.018) * (1 - progress);
      const direction = distance == 0 ? 0 : 1 / distance;
      dx += horizontal * direction * ring * 0.9 * strength;
      dy += vertical * direction * ring * 0.9 * strength;
    }
    const out = pixels + usize(y * width + x) * 4;
    store<u8>(out, encode(dx, 90)); store<u8>(out + 1, encode(dy, 90)); store<u8>(out + 2, 128); store<u8>(out + 3, 255);
  }
}
