// Fixed-memory electric geometry and simulation. No managed allocations.
const S: i32 = 64, T: i32 = 2624, P: i32 = 3072, L: i32 = 3584, O: i32 = 3784;
@inline function get(i: i32): f64 { return load<f64>(65536 + usize(i)*8); }
@inline function put(i: i32, v: f64): void { store<f64>(65536 + usize(i)*8,v); }
function noise(seed: i32, index: f64): f64 {
  let x = seed ^ (i32(i64(index+1)) * i32(0x9e3779b9));
  x = (x ^ (x >>> 16)) * 0x21f0aaad;
  x = (x ^ (x >>> 15)) * 0x735a2d97;
  return f64(u32(x ^ (x >>> 15))) / 4294967296;
}
function selectSource(seed: i32, ticket: f64): i32 {
  let selected: i32 = -1, best = Infinity;
  for(let i=0;i<i32(get(0));i++) {
    const p=S+i*5, weight=get(p+3); if(weight==0)continue;
    const score=Math.log(-Math.log(Math.max(1e-9,noise(seed ^ i32(get(p+4)),ticket))))-Math.log(weight);
    // Sources arrive sorted by id, so the first exact tie is the lexical winner.
    if(selected<0 || score<best){best=score;selected=i;}
  }
  return selected;
}
let rx: f64 = 0, ry: f64 = 0;
function nearest(x:f64,y:f64,ax:f64,ay:f64,bx:f64,by:f64):void {
  const dx=bx-ax,dy=by-ay,length=dx*dx+dy*dy;
  const t=length!=0 ? Math.max(0,Math.min(1,((x-ax)*dx+(y-ay)*dy)/length)) : 0;
  rx=ax+dx*t;ry=ay+dy*t;
}
function contain(x:f64,y:f64):void {
  const n=i32(get(1)); if(n==0){rx=x;ry=y;return;}
  let inside=false,bx=x,by=y,distance=Infinity;
  for(let i=0,j=n-1;i<n;j=i++){
    const ax=get(P+j*2),ay=get(P+j*2+1),cx=get(P+i*2),cy=get(P+i*2+1);
    if((ay>y)!=(cy>y) && x<(cx-ax)*(y-ay)/(cy-ay)+ax)inside=!inside;
    nearest(x,y,ax,ay,cx,cy);const d=Math.hypot(rx-x,ry-y);
    if(d<distance){distance=d;bx=rx;by=ry;}
  }
  rx=inside?x:bx;ry=inside?y:by;
}
function rise(x:f64,y:f64,distance:f64):void {
  const n=i32(get(1));if(n==0){rx=x;ry=Math.max(0.02,y-distance);return;}
  contain(x,y);x=rx;y=ry;
  for(let step=0;step<8 && distance>1e-9;step++){
    let onEdge=false,found=false,nx=0.0,ny=0.0,steepest=0.0;
    for(let i=0;i<n;i++){
      const j=(i+1)%n,ax=get(P+i*2),ay=get(P+i*2+1),bx=get(P+j*2),by=get(P+j*2+1);
      nearest(x,y,ax,ay,bx,by);if(Math.hypot(rx-x,ry-y)>1e-7)continue;onEdge=true;
      for(let k=0;k<2;k++){
        const vx=k==0?ax:bx,vy=k==0?ay:by,length=Math.hypot(vx-x,vy-y),slope=length!=0?(y-vy)/length:0;
        if(slope>steepest+1e-9){steepest=slope;nx=vx;ny=vy;found=true;}
      }
    }
    if(onEdge){
      if(!found){rx=x;ry=y;return;}
      const length=Math.hypot(nx-x,ny-y),travel=Math.min(distance,length),t=travel/length;
      x=x+(nx-x)*t;y=y+(ny-y)*t;distance-=travel;continue;
    }
    let travel=distance;
    for(let i=0;i<n;i++){
      const j=(i+1)%n,ax=get(P+i*2),ay=get(P+i*2+1),bx=get(P+j*2),by=get(P+j*2+1),dx=bx-ax;
      if(Math.abs(dx)<1e-12)continue;const t=(x-ax)/dx;if(t<0 || t>1)continue;
      const dy=y-(ay+(by-ay)*t);if(dy>1e-9 && dy<=travel)travel=dy;
    }
    y-=travel;distance-=travel;
  }
  rx=x;ry=y;
}
function advanceTendrils(count:i32,seed:i32,dt:f64,convection:f64):void {
  for(let i=0;i<count;i++){
    const t=T+i*14;if(get(t+11)==0)continue;put(t+4,get(t+4)+dt);
    if(get(t+10)>=0){
      put(t+10,get(t+10)+dt);rise(get(t+1),get(t+2),dt*0.055*convection);put(t+1,rx);put(t+2,ry);put(t+3,get(t+3)*Math.exp(-dt*3));
    }
    let target:i32=-1;
    if(get(t)!=0)for(let j=0;j<i32(get(0));j++)if(get(S+j*5)==get(t)){target=S+j*5;break;}
    if(target>=0){
      const weight=get(target+3),x=get(target+1),y=get(target+2);
      rise(get(t+6)+x-get(t+8),get(t+7)+y-get(t+9),dt*0.055*convection/(1+weight*weight));put(t+6,rx);put(t+7,ry);put(t+8,x);put(t+9,y);
      const blend=1-Math.exp(-dt*10);contain(get(t+1)+(rx-get(t+1))*blend,get(t+2)+(ry-get(t+2))*blend);put(t+1,rx);put(t+2,ry);
      put(t+3,get(t+3)+(weight/(1+weight)-get(t+3))*(1-Math.exp(-dt*8)));
    }
    const duration=8+noise(seed,i+300)*4;
    if(get(t+10)>=0 ? get(t+10)>=5 : get(t+4)>=duration){
      put(t+5,get(t+5)+1);put(t+4,0);put(t+12,1);
      const next=selectSource(seed,i+get(t+5)*37);
      if(next<0)put(t+11,0);
      else {
        const p=S+next*5,x=get(p+1),y=get(p+2),weight=get(p+3);
        put(t,get(p));put(t+1,x);put(t+2,y);put(t+3,weight/(1+weight));put(t+6,x);put(t+7,y);put(t+8,x);put(t+9,y);put(t+10,-1);put(t+11,1);
      }
    }
  }
}
let cursor:i32=0, lineCount:i32=0, coreCount:i32=0;
function begin():void {cursor=O+3;lineCount=0;coreCount=0;}
function line(n:i32,intensity:f64,hue:f64,width:f64):i32 {
  put(cursor,n);put(cursor+1,intensity);put(cursor+2,hue);put(cursor+3,width);cursor+=4;lineCount++;return cursor;
}
function xy(x:f64,y:f64):void {put(cursor++,x);put(cursor++,y);}
function cores():void {put(O,lineCount);put(O+1,cursor);}
function core(x:f64,y:f64,strength:f64,radius:f64):void {xy(x,y);xy(strength,radius);coreCount++;}
function finish():void {put(O+2,coreCount);}
function generateTendrils(count:i32,seed:i32,time:f64,cx:f64,cy:f64,convection:f64,crackle:f64,frequency:f64,branching:f64):void {
  begin();
  for(let i=0;i<count;i++){
    const t=T+i*14;if(get(t+11)==0)continue;
    const phase=noise(seed,i)*Math.PI*2,ex=get(t+1),ey=get(t+2),dx=ex-cx,dy=ey-cy,length=Math.hypot(dx,dy),strength=get(t+3),age=get(t+4),released=get(t+10);
    const duration=8+noise(seed,i+300)*4,fade=released>=0?Math.min(1,5-released):Math.min(1,(duration-age)/0.6),birth=get(t+12)!=0?Math.min(1,age/0.25):1;
    const intensity=(0.4+strength*0.5)*Math.max(0,fade)*birth;
    const points=line(41,intensity,250+noise(seed,i+71)*65,0.0023+strength*0.001);
    for(let j=0;j<=40;j++){
      const u=f64(j)/40,envelope=Math.sin(u*Math.PI),bend=envelope*(Math.sin(u*10+phase+time*1.8)*0.052+Math.sin(u*27-time*2.4+phase)*0.015+Math.sin(u*63+phase+time*3)*0.004);
      xy(cx+dx*u-dy*bend,cy+dy*u+dx*bend-convection*length*0.22*envelope*envelope*(0.7+0.3*Math.sin(time*0.6+phase)));
    }
    if(crackle>0){
      const tick=Math.floor(time*frequency),reach=crackle*(0.012+0.06*strength);
      for(let k=0;k<3;k++){
        const direction=noise(seed,i*131+k*31+Math.floor(tick/4)*79)*Math.PI*2;
        const spark=line(8,intensity*0.8,280,0.0012);xy(ex,ey);
        for(let j=1;j<=7;j++){
          const u=f64(j)/7,jitter=(noise(seed,i*701+tick*47+k*17+j)-0.5)*reach*0.65;
          xy(ex+Math.cos(direction)*reach*u-Math.sin(direction)*jitter,ey+Math.sin(direction)*reach*u+Math.cos(direction)*jitter);
        }
        line(2,intensity*0.4,265,0.0009);const x=get(spark+6),y=get(spark+7);xy(x,y);xy(x+Math.cos(direction+1)*reach*0.5,y+Math.sin(direction+1)*reach*0.5);
      }
    }
    for(let b=0;b<i32(Math.ceil(branching*3));b++){
      const root=points+(19+b*6)*2,x=get(root),y=get(root+1),direction=(noise(seed,i*7+b+800)-0.5)*1.1;
      line(11,intensity*branching*0.45,285,0.0013);xy(x,y);
      for(let j=1;j<=10;j++){
        const u=f64(j)/10,bx=x+(ex-x)*(u*0.7),by=y+(ey-y)*(u*0.7);
        xy(bx-dy*direction*u*0.25,by+dx*direction*u*0.25+Math.sin(u*12+phase+time*2)*0.003*u);
      }
    }
  }
  cores();
  if(crackle>0)for(let i=0;i<count;i++){
    const t=T+i*14;if(get(t+11)==0)continue;const released=get(t+10),fade=released<0?1:Math.min(1,5-released),strength=get(t+3);
    core(get(t+1),get(t+2),Math.max(0,fade)*(0.15+strength*0.7),0.008+strength*0.02);
  }
  core(cx,cy,0.95,0.045);finish();
}
function advanceLightning(dt:f64):void {
  for(let i=1;i<25;i++){const p=L+i*8;if(get(p+6)<0)put(p+4,get(p+4)*Math.exp(-dt*15));}
}
function generateLightning(seed:i32,time:f64,frequency:f64,branching:f64,active:i32,edge:i32,ax:f64,ay:f64,bx:f64,by:f64,contactCore:i32):void {
  begin();const epoch=Math.floor(time*frequency),jump=Math.floor(epoch/6);
  put(L+6,active);
  if(active!=0){
    if(edge!=0){const t=0.1+noise(seed,jump+1000)*0.8;bx=edge==1 || edge==3?t:edge==4?0.1:0.9;by=edge==1?0.1:edge==3?0.9:t;}
    put(L,ax);put(L+1,ay);put(L+2,bx);put(L+3,by);put(L+4,1);put(L+5,0);
  }
  for(let i=0;i<=i32(get(2));i++){
    const p=L+(i==0?0:i32(get(2+i)))*8;if(get(p+6)==0)continue;
    const x=get(p),y=get(p+1),ex=get(p+2),ey=get(p+3),dx=ex-x,dy=ey-y,salt=seed ^ i32(get(p+5)),strength=get(p+4);
    const intensity=strength*(0.65+noise(salt,epoch+600)*0.35);
    const points=line(25,intensity,265+noise(salt,jump)*45,0.002);
    for(let j=0;j<=24;j++){
      const u=f64(j)/24,offset=Math.sin(u*Math.PI)*((noise(salt,j+jump*41)-0.5)*0.32+(noise(salt,j+epoch*79)-0.5)*0.11);
      xy(x+dx*u-dy*offset,y+dy*u+dx*offset);
    }
    for(let j=0;j<i32(Math.ceil(branching*5));j++){
      const root=points+(5+j*3)*2,rx=get(root),ry=get(root+1),fx=(noise(salt,j+epoch*37)-0.5)*1.6,tx=rx+(ex-rx)*0.5-dy*fx,ty=ry+(ey-ry)*0.5+dx*fx;
      line(8,intensity*branching*0.75,285,0.0012);xy(rx,ry);
      for(let k=1;k<=7;k++){
        const u=f64(k)/7,px=rx+(tx-rx)*u,py=ry+(ty-ry)*u,jitter=(noise(salt,k+j*13+epoch*53)-0.5)*0.13;
        xy(px-dy*jitter,py+dx*jitter);
      }
    }
  }
  cores();if(contactCore!=0)for(let i=0;i<=i32(get(2));i++){const p=L+(i==0?0:i32(get(2+i)))*8;if(get(p+6)!=0)core(get(p),get(p+1),get(p+4),0.038);}
  finish();
}
