// f64 computation and f32 output match the shipped generator's numeric policy.
// This source also produces a matched JS control, avoiding an algorithm-only win.
@inline
function imul(a: i32,b: i32): i32 {return a*b;}
@inline
function modulo(value: i32,period: i32): i32 {return ((value%period)+period)%period;}
@inline
function hash(x: i32,y: i32,seed: i32): f64 {
  let n=imul(x,374761393)^imul(y,668265263)^seed;
  n=imul(n^(n>>>13),1274126177);
  return f64(u32(n^(n>>>16)))/4294967296;
}
function noise(x: f64,y: f64,seed: i32,periodX: i32,periodY: i32): f64 {
  const ix=i32(Math.floor(x)),iy=i32(Math.floor(y)),fx=x-ix,fy=y-iy;
  const sx=fx*fx*(3-2*fx),sy=fy*fy*(3-2*fy);
  const x0=modulo(ix,periodX),x1=modulo(ix+1,periodX),y0=modulo(iy,periodY),y1=modulo(iy+1,periodY);
  return (hash(x0,y0,seed)*(1-sx)+hash(x1,y0,seed)*sx)*(1-sy)
    +(hash(x0,y1,seed)*(1-sx)+hash(x1,y1,seed)*sx)*sy;
}
function turbulence(u: f64,v: f64,seed: i32,frequency: i32,ox: f64,oy: f64,octaves: i32): f64 {
  let result: f64=0,amplitude: f64=.5;
  for(let octave=0;octave<octaves;octave++) {
    result+=noise(u*frequency+ox,v*frequency+oy,seed+octave,frequency,frequency)*amplitude;
    amplitude*=.5;frequency*=2;ox*=2;oy*=2;
  }
  return result;
}
function cellular(u: f64,v: f64,seed: i32,frequency: i32,detail: f64): f64 {
  const px=u*frequency,py=v*frequency,ix=i32(Math.floor(px)),iy=i32(Math.floor(py));
  let first: f64=Infinity,second: f64=Infinity;
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++) {
    const cx=ix+dx,cy=iy+dy,hx=modulo(cx,frequency),hy=modulo(cy,frequency);
    const sx=cx+.5+(hash(hx,hy,seed)-.5)*detail,sy=cy+.5+(hash(hx,hy,seed^0x5bd1e995)-.5)*detail;
    const distance=Math.hypot(px-sx,py-sy);
    if(distance<first) {second=first;first=distance;}else if(distance<second)second=distance;
  }
  return Math.max(0,Math.min(1,(second-first)*2.2));
}
function sample(kind: i32,u: f64,v: f64,x: i32,y: i32,w: i32,h: i32,seed: i32,scale: f64,detail: f64,ox: f64,oy: f64): f64 {
  if(kind===0) {
    const frequency=i32(Math.max(1,Math.round(scale))),bandsX=Math.max(1,Math.round(scale*.7)),bandsY=Math.max(1,Math.round(scale*.25));
    const warp=turbulence(u,v,seed,frequency,ox,oy,4);
    const wave=Math.sin((u*bandsX+v*bandsY+warp*(2+detail*7))*Math.PI*2);
    return Math.pow(1-Math.abs(wave),2.5)*.9+warp*.1;
  }
  if(kind===1) {
    const broad=i32(Math.max(1,Math.round(scale*.7))),fiberX=i32(Math.max(1,Math.round(scale*7))),fiberY=i32(Math.max(1,Math.round(scale*4)));
    const pulp=noise(u*broad+ox,v*broad+oy,seed,broad,broad);
    const fibers=(noise((u+v)*fiberX+ox,(v-u)*fiberY+oy,seed+1,fiberX,fiberY)+noise((u-v)*fiberX+oy,(v+u)*fiberY+ox,seed+2,fiberX,fiberY))*.5;
    const grain=hash(x%(w-1),y%(h-1),seed);
    return .12+(pulp-.5)*.044+(fibers-.5)*(.025+detail*.025)+(grain-.5)*(.015+detail*.0875);
  }
  return cellular(u,v,seed,i32(Math.max(1,Math.round(scale))),detail);
}

let randomState: i32 = 0;
function random(): f64 {
  randomState += 0x6d2b79f5;
  let n = (randomState ^ (randomState >>> 15)) * (1 | randomState);
  n ^= n + (n ^ (n >>> 7)) * (61 | n);
  return f64(u32(n ^ (n >>> 14))) / 4294967296;
}
export function generate(out: usize,w: i32,h: i32,kind: i32,seed: i32,scale: f64,detail: f64): void {
  randomState=seed;
  const ox=random()*100,oy=random()*100;
  for(let y=0;y<h;y++)for(let x=0;x<w;x++) {
    store<f32>(out+usize(y*w+x)*4,f32(sample(kind,f64(x)/(w-1),f64(y)/(h-1),x,y,w,h,seed,scale,detail,ox,oy)));
  }
}

export function colorize(field: usize, lut: usize, pixels: usize, alpha: usize, count: i32, gain: f64): void {
  for (let i = 0; i < count; i++) {
    const v = i32(Math.max(0, Math.min(255, Math.floor(f64(load<f32>(field + usize(i) * 4)) * 255 * gain + 0.5))));
    store<u32>(pixels + usize(i) * 4, load<u32>(lut + usize(v) * 4) | 0xff000000);
    store<u8>(alpha + usize(i), u8(v));
  }
}
