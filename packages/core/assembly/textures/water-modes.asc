// @ts-nocheck -- shared allocation-free water math, compiled by AssemblyScript.
export function initializeModes(ptr: usize, seed: i32, scale: i32): void {
  for (let i = 0; i < 4; i++) {
    let x = seed + (i + 1) * i32(0x9e3779b9);
    x ^= i32(u32(x) >> 16); x *= i32(0x85ebca6b); x ^= i32(u32(x) >> 13);
    const y = u32((x ^ i32(u32(x) >> 15)) * i32(0x27d4eb2d));
    store<f64>(ptr + usize(i) * 24, f64((x % scale + 1) * ((x & 1) != 0 ? -1 : 1)));
    store<f64>(ptr + usize(i) * 24 + 8, f64((i32(y % u32(scale)) + 1) * ((y & 1) != 0 ? -1 : 1)));
    store<f64>(ptr + usize(i) * 24 + 16, (f64(u32(x) >> 24) / 255) * Math.PI * 2);
  }
}
@inline function sign(value: f64): f64 { return value > 0 ? 1 : value < 0 ? -1 : 0; }
@inline function encode(value: f64, scale: f64): u8 { return u8(Math.max(0, Math.min(255, Math.floor(128 + value * scale + 0.5)))); }
