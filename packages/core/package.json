{
  "name": "@pibbl/core",
  "type": "module",
  "version": "0.0.1",
  "description": "Canvas 2D component runtime with JSX and createElement authoring",
  "author": "Ben Lesh <ben@benlesh.com>",
  "license": "MIT",
  "homepage": "https://github.com/benlesh/crc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benlesh/crc.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/benlesh/crc/issues",
  "keywords": [
    "canvas",
    "jsx",
    "graphics"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.mjs"
    },
    "./filters": {
      "types": "./dist/filters.d.ts",
      "default": "./dist/filters.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json",
    "./particles": {
      "types": "./dist/features/particles/index.d.ts",
      "default": "./dist/features/particles/index.mjs"
    },
    "./viz": {
      "types": "./dist/features/viz/index.d.ts",
      "default": "./dist/features/viz/index.mjs"
    },
    "./textures": {
      "types": "./dist/features/textures/index.d.ts",
      "default": "./dist/features/textures/index.mjs"
    },
    "./physics/2d": {
      "types": "./dist/features/physics/2d.d.ts",
      "default": "./dist/features/physics/2d.mjs"
    },
    "./physics/2d/geometry": {
      "types": "./dist/features/physics/2d-geometry.d.ts",
      "default": "./dist/features/physics/2d-geometry.mjs"
    },
    "./physics/2d/testing": {
      "types": "./dist/features/physics/2d-testing.d.ts",
      "default": "./dist/features/physics/2d-testing.mjs"
    },
    "./sprites": {
      "types": "./dist/features/sprites/index.d.ts",
      "default": "./dist/features/sprites/index.mjs"
    },
    "./sprites/formats/aseprite": {
      "types": "./dist/features/sprites/formats/aseprite.d.ts",
      "default": "./dist/features/sprites/formats/aseprite.mjs"
    },
    "./sprites/formats/texture-packer": {
      "types": "./dist/features/sprites/formats/texture-packer.d.ts",
      "default": "./dist/features/sprites/formats/texture-packer.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types.d.ts"
      ],
      "filters": [
        "./dist/filters.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ],
      "*": [
        "./dist/*",
        "./*"
      ],
      "jsx-runtime": [
        "./dist/jsx-runtime.d.ts"
      ],
      "jsx-dev-runtime": [
        "./dist/jsx-dev-runtime.d.ts"
      ],
      "particles": [
        "./dist/features/particles/index.d.ts"
      ],
      "viz": [
        "./dist/features/viz/index.d.ts"
      ],
      "textures": [
        "./dist/features/textures/index.d.ts"
      ],
      "physics/2d": [
        "./dist/features/physics/2d.d.ts"
      ],
      "physics/2d/geometry": [
        "./dist/features/physics/2d-geometry.d.ts"
      ],
      "physics/2d/testing": [
        "./dist/features/physics/2d-testing.d.ts"
      ],
      "sprites": [
        "./dist/features/sprites/index.d.ts"
      ],
      "sprites/formats/aseprite": [
        "./dist/features/sprites/formats/aseprite.d.ts"
      ],
      "sprites/formats/texture-packer": [
        "./dist/features/sprites/formats/texture-packer.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "node ../../tooling/build-transition-wasm.mjs --check && rimraf dist && tsc -p tsconfig.build.json && node ../../tooling/build-core.mjs",
    "dev": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "vitest"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "assemblyscript": "0.28.20"
  }
}
