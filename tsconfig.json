{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "paths": {
      "@crc/core/internal": ["./packages/core/src/internal.ts"],
      "@crc/core/jsx-dev-runtime": ["./packages/core/src/jsx-dev-runtime.ts"],
      "@crc/core/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@crc/core/types": ["./packages/core/src/types.ts"],
      "@crc/core": ["./packages/core/src/index.ts"],
      "@crc/particles": ["./packages/particles/src/index.ts"],
      "@crc/particles/webgl": ["./packages/particles/src/webgl.ts"],
      "@crc/webgl/internal": ["./packages/webgl/src/internal.ts"],
      "@crc/webgl": ["./packages/webgl/src/index.ts"],
      "@crc/types": ["./packages/types/src/index.ts"],
      "virtual:crc-studio-docs": ["./playground/src/studio-docs.d.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "vitest/config"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@crc/core",
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "eslint.config.mjs"],
  "exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**"
  ]
}
