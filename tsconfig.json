{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "paths": {
      "@pibbl/core/filters": ["./packages/core/src/filters.ts"],
      "@pibbl/core/internal": ["./packages/core/src/internal.ts"],
      "@pibbl/core/jsx-dev-runtime": ["./packages/core/src/jsx-dev-runtime.ts"],
      "@pibbl/core/jsx-runtime": ["./packages/core/src/jsx-runtime.ts"],
      "@pibbl/core/types": ["./packages/core/src/types.ts"],
      "@pibbl/core": ["./packages/core/src/index.ts"],
      "@pibbl/core/particles": [
        "./packages/core/src/features/particles/index.ts"
      ],
      "@pibbl/three": ["./packages/three/src/index.ts"],
      "@pibbl/core/physics/2d/geometry": [
        "./packages/core/src/features/physics/2d-geometry.ts"
      ],
      "@pibbl/core/physics/2d/testing": [
        "./packages/core/src/features/physics/2d-testing.ts"
      ],
      "@pibbl/core/physics/2d": ["./packages/core/src/features/physics/2d.ts"],
      "virtual:pibbl-studio-docs": ["./playground/src/studio-docs.d.ts"],
      "@pibbl/core/viz": ["./packages/core/src/features/viz/index.ts"],
      "@pibbl/core/textures": [
        "./packages/core/src/features/textures/index.ts"
      ],
      "@pibbl/text": ["./packages/text/src/index.ts"],
      "@pibbl/core/sprites": ["./packages/core/src/features/sprites/index.ts"],
      "@pibbl/core/sprites/formats/*": [
        "./packages/core/src/features/sprites/formats/*.ts"
      ],
      "@pibbl/core/machines": [
        "./packages/core/src/features/machines/index.ts"
      ],
      "@pibbl/core/machines/animation": [
        "./packages/core/src/features/machines/animation.ts"
      ],
      "@pibbl/core/viz/inspection": [
        "./packages/core/src/features/viz/inspection.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "vitest/config"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@pibbl/core",
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "eslint.config.mjs"],
  "exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**",
    "packages/core/src/features/physics/**"
  ]
}
