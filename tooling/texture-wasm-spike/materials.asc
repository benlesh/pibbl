// f64 computation and f32 output match the shipped generator's numeric policy.
// This source also produces a matched JS control, avoiding an algorithm-only win.
@inline
function imul(a: i32,b: i32): i32 {return a*b;}
@inline
function modulo(value: i32,period: i32): i32 {return ((value%period)+period)%period;}
@inline
function hash(x: i32,y: i32,seed: i32): f64 {
  let n=imul(x,374761393)^imul(y,668265263)^seed;
  n=imul(n^(n>>>13),1274126177);
  return f64(u32(n^(n>>>16)))/4294967296;
}
function noise(x: f64,y: f64,seed: i32,periodX: i32,periodY: i32): f64 {
  const ix=i32(Math.floor(x)),iy=i32(Math.floor(y)),fx=x-ix,fy=y-iy;
  const sx=fx*fx*(3-2*fx),sy=fy*fy*(3-2*fy);
  const x0=modulo(ix,periodX),x1=modulo(ix+1,periodX),y0=modulo(iy,periodY),y1=modulo(iy+1,periodY);
  return (hash(x0,y0,seed)*(1-sx)+hash(x1,y0,seed)*sx)*(1-sy)
    +(hash(x0,y1,seed)*(1-sx)+hash(x1,y1,seed)*sx)*sy;
}
function turbulence(u: f64,v: f64,seed: i32,frequency: i32,ox: f64,oy: f64,octaves: i32): f64 {
  let result: f64=0,amplitude: f64=.5;
  for(let octave=0;octave<octaves;octave++) {
    result+=noise(u*frequency+ox,v*frequency+oy,seed+octave,frequency,frequency)*amplitude;
    amplitude*=.5;frequency*=2;ox*=2;oy*=2;
  }
  return result;
}
function cellular(u: f64,v: f64,seed: i32,frequency: i32,detail: f64): f64 {
  const px=u*frequency,py=v*frequency,ix=i32(Math.floor(px)),iy=i32(Math.floor(py));
  let first: f64=Infinity,second: f64=Infinity;
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++) {
    const cx=ix+dx,cy=iy+dy,hx=modulo(cx,frequency),hy=modulo(cy,frequency);
    const sx=cx+.5+(hash(hx,hy,seed)-.5)*detail,sy=cy+.5+(hash(hx,hy,seed^0x5bd1e995)-.5)*detail;
    const distance=Math.hypot(px-sx,py-sy);
    if(distance<first) {second=first;first=distance;}else if(distance<second)second=distance;
  }
  return Math.max(0,Math.min(1,(second-first)*2.2));
}
function sample(kind: i32,u: f64,v: f64,x: i32,y: i32,w: i32,h: i32,seed: i32,scale: f64,detail: f64,ox: f64,oy: f64): f64 {
  if(kind===0) {
    const frequency=i32(Math.max(1,Math.round(scale))),bandsX=Math.max(1,Math.round(scale*.7)),bandsY=Math.max(1,Math.round(scale*.25));
    const warp=turbulence(u,v,seed,frequency,ox,oy,4);
    const wave=Math.sin((u*bandsX+v*bandsY+warp*(2+detail*7))*Math.PI*2);
    return Math.pow(1-Math.abs(wave),2.5)*.9+warp*.1;
  }
  if(kind===1) {
    const broad=i32(Math.max(1,Math.round(scale*.7))),fiberX=i32(Math.max(1,Math.round(scale*7))),fiberY=i32(Math.max(1,Math.round(scale*4)));
    const pulp=noise(u*broad+ox,v*broad+oy,seed,broad,broad);
    const fibers=(noise((u+v)*fiberX+ox,(v-u)*fiberY+oy,seed+1,fiberX,fiberY)+noise((u-v)*fiberX+oy,(v+u)*fiberY+ox,seed+2,fiberX,fiberY))*.5;
    const grain=hash(x%(w-1),y%(h-1),seed);
    return .12+(pulp-.5)*.044+(fibers-.5)*(.025+detail*.025)+(grain-.5)*(.015+detail*.0875);
  }
  return cellular(u,v,seed,i32(Math.max(1,Math.round(scale))),detail);
}
// Richer candidates: periodic detail rather than simply a larger raster.
function enhanced(kind: i32,u: f64,v: f64,x: i32,y: i32,w: i32,h: i32,seed: i32,scale: f64,detail: f64,ox: f64,oy: f64): f64 {
  const frequency=i32(Math.max(1,Math.round(scale)));
  if(kind===0) {
    const broad=i32(Math.max(1,Math.round(scale*.35)));
    const wx=turbulence(u,v,seed+17,broad,ox,oy,3)-.4375;
    const wy=turbulence(u,v,seed+31,broad,oy,ox,3)-.4375;
    const warp=turbulence(u+wx*.16,v+wy*.16,seed,frequency,ox,oy,6);
    const cloud=noise(u*broad+ox,v*broad+oy,seed+9,broad,broad);
    const phase=(u*Math.max(1,Math.round(scale*.35))+v*Math.max(1,Math.round(scale*.17))+warp*(2+detail*5))*Math.PI*2;
    const primary=Math.pow(1-Math.abs(Math.sin(phase)),5+cloud*8);
    const hairline=Math.pow(1-Math.abs(Math.sin(phase*2+warp*4)),18);
    return Math.max(0,Math.min(1,.035+cloud*.12+primary*.72+hairline*.10));
  }
  if(kind===1) {
    const pulp=turbulence(u,v,seed,frequency,ox,oy,4);
    let fibers: f64=0,relief: f64=0;
    for(let octave=0;octave<3;octave++) {
      const fx=frequency*(8<<octave),fy=frequency*(2<<octave);
      const a=noise((u+v)*fx+ox,(v-u)*fy+oy,seed+octave+11,fx,fy);
      const b=noise((u-v)*fx+oy,(v+u)*fy+ox,seed+octave+19,fx,fy);
      fibers+=(Math.pow(a,4)+Math.pow(b,4))*.5/f64(1<<octave);
      if(octave===0)relief=noise((u+v)*fx+ox+.12,(v-u)*fy+oy+.04,seed+11,fx,fy)-a;
    }
    const grain=hash(x%(w-1),y%(h-1),seed);
    return Math.max(0,Math.min(1,.12+(pulp-.47)*.065+(fibers-.22)*(.12+detail*.09)+relief*.18+(grain-.5)*.018));
  }
  const edge=cellular(u,v,seed,frequency,detail),epsilon=.002/frequency;
  const right=cellular(u+epsilon,v,seed,frequency,detail),down=cellular(u,v+epsilon,seed,frequency,detail);
  const bevel=Math.sqrt(edge),slope=(Math.sqrt(right)-bevel+Math.sqrt(down)-bevel)/.002;
  const grain=turbulence(u,v,seed+53,frequency*3,ox,oy,3);
  return Math.max(0,Math.min(1,.06+bevel*.75+Math.max(-.14,Math.min(.14,slope*.025))+(grain-.44)*.12));
}
export function generate(out: usize,w: i32,h: i32,kind: i32,seed: i32,scale: f64,detail: f64,ox: f64,oy: f64,quality: i32): void {
  for(let y=0;y<h;y++)for(let x=0;x<w;x++) {
    const u=f64(x)/(w-1),v=f64(y)/(h-1);
    let result: f64=0;
    if(quality===0)result=sample(kind,u,v,x,y,w,h,seed,scale,detail,ox,oy);
    else if(kind!==0)result=enhanced(kind,u,v,x,y,w,h,seed,scale,detail,ox,oy);
    if(quality!==0 && kind===0) {
      // Four stratified samples retain thin veins without turning them into speckle.
      const du=.25/(w-1),dv=.25/(h-1);
      result=(enhanced(kind,u-du,v-dv,x,y,w,h,seed,scale,detail,ox,oy)
        +enhanced(kind,u+du,v-dv,x,y,w,h,seed,scale,detail,ox,oy)
        +enhanced(kind,u-du,v+dv,x,y,w,h,seed,scale,detail,ox,oy)
        +enhanced(kind,u+du,v+dv,x,y,w,h,seed,scale,detail,ox,oy))*.25;
    }
    store<f32>(out+usize(y*w+x)*4,f32(result));
  }
}
export function colorize(field: usize,lut: usize,pixels: usize,alpha: usize,count: i32): void {
  for(let i=0;i<count;i++) {
    const value=i32(Math.max(0,Math.min(255,Math.floor(f64(load<f32>(field+usize(i)*4))*255+.5))));
    store<u32>(pixels+usize(i)*4,load<u32>(lut+usize(value)*4)|0xff000000);
    store<u8>(alpha+usize(i),u8(value));
  }
}
