// Float64 descriptors: x, y, length, width, hue, alpha. One call per beam.
// Static seeded coefficients are initialized once per definition.
export function initialize(seed: f64): void {
  for (let i = 0; i < 56; i++) for (let j = 1; j <= 8; j++) {
    const v = Math.sin((i * 11 + j) * 127.1 + seed * 31.7) * 43758.5453;
    store<f64>(32768 + (i * 8 + j - 1) * 8, v - Math.floor(v));
  }
}
export function sample(seconds: f64, flow: f64, power: f64, width: f64, distance: f64, ex: f64, ey: f64, dx: f64, dy: f64): void {
  const angle = Math.atan2(dy, dx);
  for (let i = 0; i < 56; i++) {
    const p = 32768 + i * 64;
    const position = load<f64>(p + 8) * 1.8 + flow * seconds * (1.6 + load<f64>(p) * 2.8);
    const t = ((position % 1.8) + 1.8) % 1.8 - .4;
    const lateral = (load<f64>(p + 16) - .5) * width * .95 + Math.sin(seconds * 3 + load<f64>(p + 24) * 20) * width * .035;
    const out = 16384 + i * 48;
    store<f64>(out, ex + dx * t - Math.sin(angle) * lateral);
    store<f64>(out + 8, ey + dy * t + Math.cos(angle) * lateral);
    store<f64>(out + 16, Math.max(20, distance * (.13 + load<f64>(p + 32) * .28)));
    store<f64>(out + 24, Math.max(4, width * (.045 + load<f64>(p + 40) * .13)));
    store<f64>(out + 32, load<f64>(p + 48) * 360);
    store<f64>(out + 40, power * (.14 + load<f64>(p + 56) * .22));
  }
}
