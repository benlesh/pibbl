{
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:format",
    "lint:code": "eslint . --cache",
    "lint:format": "prettier --check '**/*.{md,css,json,jsonc,yaml,yml}'",
    "format": "prettier --write '**/*.{md,css,json,jsonc,yaml,yml}'",
    "release": "bumpp",
    "publish:ci": "pnpm -r publish --access public --no-git-checks",
    "test": "pnpm test:ui",
    "test:ci": "vitest run --browser.headless",
    "test:smoke": "vitest run packages/core/test/smoke-scenario.test.ts --browser.headless --browser.ui=false",
    "test:smoke:built": "pnpm build && vitest run packages/core/test/smoke-scenario.test.ts --mode built --browser.headless --browser.ui=false",
    "test:package-consumer": "pnpm build && tsc -p playground/package-consumer/tsconfig.bundler.json && tsc -p playground/package-consumer/tsconfig.nodenext.json && node playground/package-consumer/runtime.mjs",
    "test:package-consumer:packed": "pnpm build && node tooling/verify-packed-consumer.mjs",
    "test:visual-safeguard": "node tooling/verify-visual-safeguard.mjs",
    "test:lifecycle": "vitest run packages/core/test/lifecycle-ownership.test.ts packages/core/test/runtime-cleanup-stress.test.ts --browser.headless --browser.ui=false",
    "test:performance": "vitest run packages/core/test/event-performance.test.ts --browser.headless --browser.ui=false",
    "test:performance:reference": "VITE_CRC_PERF_GUARD=1 VITE_CRC_REPORT_PERF=1 vitest run packages/core/test/event-performance.test.ts --browser.headless --browser.ui=false",
    "scenarios:check": "tsx tooling/scenario-catalog.ts",
    "scenarios:write-index": "tsx tooling/scenario-catalog.ts --write",
    "test:ui": "vitest --browser.headless=false",
    "test:watch": "vitest --browser.headless",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev && pnpm playground",
    "playground": "pnpm -C playground run playground:dev",
    "playground:built": "pnpm build && pnpm -C playground run playground:built",
    "playground:build": "pnpm -C playground run playground:build",
    "playground:build:built": "pnpm build && pnpm -C playground run playground:build:built",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/eslint-parser": "catalog:",
    "@eslint/js": "catalog:",
    "@crc/scenarios": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "globals": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
