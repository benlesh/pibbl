{
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:format",
    "lint:code": "eslint . --cache",
    "lint:format": "prettier --check '**/*.{md,css,json,jsonc,yaml,yml}'",
    "format": "prettier --write '**/*.{md,css,json,jsonc,yaml,yml}'",
    "release": "bumpp",
    "publish:ci": "pnpm -r publish --access public --no-git-checks",
    "test": "pnpm test:ui",
    "test:ci": "vitest run --browser.headless",
    "test:smoke": "vitest run packages/core/test/smoke-scenario.test.ts --browser.headless --browser.ui=false",
    "test:ui": "vitest --browser.headless=false",
    "test:watch": "vitest --browser.headless",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev && pnpm playground",
    "playground": "pnpm -C playground run playground:dev",
    "playground:build": "pnpm -C playground run playground:build",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/eslint-parser": "catalog:",
    "@eslint/js": "catalog:",
    "@antfu/ni": "catalog:",
    "@crc/scenarios": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/ui": "catalog:",
    "bumpp": "catalog:",
    "diff-match-patch-es": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "esno": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "jsonc-parser": "catalog:",
    "picocolors": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
