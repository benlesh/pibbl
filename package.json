{
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "scripts": {
    "lint": "eslint . --cache",
    "release": "bumpp",
    "publish:ci": "pnpm -r publish --access public --no-git-checks",
    "test": "pnpm test:ui",
    "test:ci": "vitest run --browser.headless",
    "test:smoke": "vitest run packages/core/test/smoke-scenario.test.ts --browser.headless --browser.ui=false",
    "test:ui": "vitest --browser.headless=false",
    "test:watch": "vitest --browser.headless",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev && pnpm playground",
    "playground": "pnpm -C playground run playground:dev",
    "playground:build": "pnpm -C playground run playground:build",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@crc/scenarios": "workspace:*",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "bumpp": "catalog:",
    "diff-match-patch-es": "^0.1.1",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "esno": "catalog:",
    "fs-extra": "^11.2.0",
    "jiti": "catalog:",
    "jsonc-parser": "catalog:",
    "picocolors": "catalog:",
    "playwright": "^1.49.0",
    "pnpm": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-copy": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-esbuild": "catalog:",
    "rollup-plugin-typescript2": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "^2.1.8",
    "vue-tsc": "catalog:"
  }
}
