---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import ButtonDemo from './ButtonDemo.astro';
import CatalogDemo from './CatalogDemo.astro';
import EffectDemo from './EffectDemo.astro';
import Gallery from './Gallery.astro';
import MinimalPreview from './MinimalPreview.astro';
import { galleries, galleryExamples } from '../../gallery.mjs';
const route = Astro.url.pathname.replace(/\/$/, '');
const slug = route.split('/').at(-1);
const gallery = galleries.find(gallery => route === `/catalogs/${gallery.id}`);
---
<Default>
  {route.startsWith('/minimal-examples/') && <MinimalPreview id={route.slice('/minimal-examples/'.length)} />}
  {route.startsWith('/examples/') && galleryExamples.some(example => example.slug === slug) && <EffectDemo slug={slug} />}
  {gallery && <Gallery slugs={gallery.slugs} />}
  {route === '/guides/native-button' && <ButtonDemo />}
  {['/catalogs/shapes/circle', '/catalogs/filters/blur', '/catalogs/textures/marble'].includes(route) && <CatalogDemo kind={route.split('/').at(-1)} />}
  <slot />
</Default>
