<button type="button" id="website-search" aria-label="Search documentation">Search docs <kbd>⌘/Ctrl K</kbd></button>
<script>
  import { mountSearchDialog } from '../../../playground/src/search/search-dialog';
  import { websiteUrlForStudioDocument, resolveWebsiteLegacyHash } from '../../../tooling/studio-docs/website-routes';
  if (window.location.pathname !== '/playground/' && window.location.hash.startsWith('#/')) {
    void fetch('/legacy-routes.json').then(response => response.json()).then(routes => {
      const destination = resolveWebsiteLegacyHash(window.location.hash, routes);
      if (destination) window.location.replace(destination);
    }).catch(() => { /* Leave the current page readable if the migration map is unavailable. */ });
  }
  const button = document.getElementById('website-search')!;
  const search = mountSearchDialog({
    async loadBundle() {
      const response = await fetch('/search.json');
      if (!response.ok) throw new Error('Unable to load documentation search.');
      return response.json();
    },
    navigate(hash) {
      window.location.assign(hash.startsWith('#/examples')
        ? `/playground/${hash}`
        : websiteUrlForStudioDocument(hash, window.location.origin + '/'));
    },
  });
  button.addEventListener('click', () => search.open(button));
  window.addEventListener('beforeunload', () => search.dispose(), { once: true });
</script>
<style is:global>
  #website-search { padding: .5rem .75rem; color: var(--sl-color-text); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: .25rem; cursor: pointer; }
  #website-search kbd { margin-inline-start: .75rem; font-size: .75rem; }
  .studio-search-dialog { width: min(760px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 1rem; overflow: auto; background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); }
  .studio-search-dialog::backdrop { background: #0008; }
  .studio-search-dialog__header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .studio-search-dialog__close { padding: .25rem .75rem; }
  .studio-search-dialog__label { display: block; margin-block: 1rem .5rem; }
  .studio-search-dialog__input { width: 100%; padding: .75rem; font: inherit; }
  .studio-search-dialog__filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1rem; }
  .studio-search-dialog button { cursor: pointer; padding: .4rem .6rem; }
  .studio-search-dialog__filters .is-selected { font-weight: bold; text-decoration: underline; }
  .studio-search-dialog__results { padding: 0; list-style: none; }
  .studio-search-result { display: grid; gap: .35rem; padding: .75rem; border-bottom: 1px solid var(--sl-color-gray-5); cursor: pointer; }
  .studio-search-result.is-active { outline: 2px solid var(--sl-color-text-accent); outline-offset: -2px; }
  .studio-search-result__header { display: flex; gap: 1rem; justify-content: space-between; }
  .studio-search-result__breadcrumb, .studio-search-result__excerpt { font-size: .85rem; overflow-wrap: anywhere; }
  @media (max-width: 50rem) { #website-search kbd { display: none; } }
</style>
